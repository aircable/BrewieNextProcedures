{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrewieNext Program Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "programs"],
  "properties": {
    "schema_version": {"const": 1},
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "category", "description", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string", "minLength": 1},
          "category": {"enum": ["brewing", "cleaning", "maintenance", "diagnostics"]},
          "description": {"type": "string", "minLength": 1},
          "status": {"enum": ["design", "available"]},
          "workflow": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "available"}}},
            "then": {"required": ["workflow"]}
          }
        ]
      }
    }
  }
}
